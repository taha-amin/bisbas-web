# Live charges: use sk_live_... from https://dashboard.stripe.com/apikeys
# Local testing: use sk_test_...
# Never commit real keys. Set them in Netlify → Environment variables.
STRIPE_SECRET_KEY=sk_live_replace_me

# Must be the public site customers use (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://bisbaspdx.com

# Stripe webhook signing secret from Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend (https://resend.com) sends order emails. Verify bisbaspdx.com there.
RESEND_API_KEY=re_replace_me
ORDER_FROM_EMAIL=Bisbas <orders@bisbaspdx.com>
ORDER_NOTIFICATION_EMAIL=orders@bisbaspdx.com
